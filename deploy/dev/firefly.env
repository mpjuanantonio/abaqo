# DEV ONLY - FAKE VALUES. Safe to commit. Never reuse anywhere else.
# Read only by the dev-firefly service. Names per
# https://github.com/firefly-iii/firefly-iii/blob/main/.env.example
# APP_KEY and STATIC_CRON_TOKEN must be exactly 32 characters.
APP_KEY=DEVONLY-FAKE-APP-KEY-0000000000x
STATIC_CRON_TOKEN=DEVONLY-FAKE-CRON-TOKEN-00000000
APP_ENV=local
APP_DEBUG=false
SITE_OWNER=dev@abaqo.invalid
DEFAULT_LANGUAGE=es_ES
TZ=Europe/Madrid
APP_URL=http://127.0.0.1:18080
TRUSTED_PROXIES=**
LOG_CHANNEL=stack
APP_LOG_LEVEL=notice
DB_CONNECTION=pgsql
DB_HOST=dev-postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=dev-only-fake-firefly-db-password
