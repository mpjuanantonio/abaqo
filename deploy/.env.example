# Abaqo environment TEMPLATE. Never commit a filled-in copy.
# - Abaqo API / full profile: copy to deploy/.env (gitignored).
# - Owner-only bank test: copy to ~/.config/abaqo/banktest.env (mode 600, OUTSIDE any repo) and
#   pass it with `--env-file`. See deploy/README.md, "Bank test (owner only)".
# Variables are added here as each service is introduced; every one must be documented.

# --- Abaqo API ---
# Port the API listens on inside its container.
PORT=3100

# --- Firefly III as seen by the Abaqo API ---
# Base URL of the Firefly III instance the Abaqo API talks to.
FIREFLY_URL=
# Firefly personal access token (Firefly UI > Options > Profile > OAuth > Personal Access Tokens).
# Never commit it. Not used by the banktest stack: its importer holds no token on purpose
# (it has no login of its own); paste the token in the importer UI each session instead.
# NOTE: the dev stack does NOT use these variables. Its token lives in deploy/dev/.dev-token and
# the seed script only reads DEV_FIREFLY_URL / DEV_FIREFLY_TOKEN, so it cannot touch this Firefly.
FIREFLY_TOKEN=

# =============================================================================
# Bank test stack (owner only, REAL bank data). Used by:
#   docker compose -f deploy/docker-compose.banktest.yml --env-file ~/.config/abaqo/banktest.env up -d
# Required (Compose refuses to start without them): the three DB passwords, FIREFLY_APP_KEY,
# FIREFLY_STATIC_CRON_TOKEN.
# Use plain KEY=value lines. Avoid "$" in passwords (Compose would interpolate it).
# =============================================================================

# Postgres superuser and the two application roles. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
FIREFLY_DB_PASSWORD=
ABAQO_DB_PASSWORD=

# Firefly III APP_KEY: exactly 32 characters. Generate with: openssl rand -hex 16
FIREFLY_APP_KEY=
# Firefly cron token: exactly 32 characters. Generate with: openssl rand -hex 16
FIREFLY_STATIC_CRON_TOKEN=
# Your email; Firefly shows it in some errors.
FIREFLY_SITE_OWNER=
# URL where YOU open Firefly in the browser (no trailing slash). Locally:
# http://127.0.0.1:28080  (or the tailscale serve URL if you publish Firefly too).
FIREFLY_PUBLIC_URL=http://127.0.0.1:28080

# Enable Banking (Control Panel > your application). Never commit these.
# Application ID: the UUID shown for the application.
ENABLE_BANKING_APP_ID=
# Private key: the downloaded PEM as ONE line with literal \n, inside double quotes, e.g.
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
ENABLE_BANKING_PRIVATE_KEY=
# Set to true only if your bank requires the PSU-IP-Address header; then set the IP below
# ("autodetect" calls an external service, icanhazip.com).
ENABLE_BANKING_IMPORT_IP_HEADER=false
ENABLE_BANKING_IMPORT_IP=127.0.0.1
